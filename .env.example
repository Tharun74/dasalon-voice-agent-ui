# Keep the key and session secret out of NEXT_PUBLIC_* and source control.
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b-conversations
SARVAM_CLASSIFIER_MODEL=sarvam-105b-conversations
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_STT_MODEL=saaras:v4
DEFAULT_LANGUAGE=en-IN
DEFAULT_SPEAKER=shubh
SARVAM_SPEAKING_PACE=1
SESSION_SECRET=
VOICE_ALLOWED_ORIGINS=
# Optional interim captions via bounded, additional transcription requests.
SARVAM_STT_SNAPSHOTS=true
RATE_LIMIT_IP_PER_MINUTE=60
RATE_LIMIT_SESSION_PER_MINUTE=45
RATE_LIMIT_SESSION_TURNS=20
RATE_LIMIT_SESSION_TTS_CHARACTERS=3000
DAILY_BUDGET_PROVIDER_CALLS=2000

{
  "name": "@dasalon/voice-agent-ui",
  "version": "0.1.0",
  "description": "Voice-agent motion components for salon, spa and barbershop websites",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE-SHADERS"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./lumen": {
      "types": "./dist/presets/lumen.d.ts",
      "import": "./dist/presets/lumen.js"
    },
    "./silk": {
      "types": "./dist/presets/silk.d.ts",
      "import": "./dist/presets/silk.js"
    },
    "./mirror": {
      "types": "./dist/presets/mirror.d.ts",
      "import": "./dist/presets/mirror.js"
    },
    "./bloom": {
      "types": "./dist/presets/bloom.d.ts",
      "import": "./dist/presets/bloom.js"
    },
    "./prism": {
      "types": "./dist/presets/prism.d.ts",
      "import": "./dist/presets/prism.js"
    },
    "./stardust": {
      "types": "./dist/presets/stardust.d.ts",
      "import": "./dist/presets/stardust.js"
    },
    "./dock": {
      "types": "./dist/presets/dock.d.ts",
      "import": "./dist/presets/dock.js"
    },
    "./contour": {
      "types": "./dist/presets/contour.d.ts",
      "import": "./dist/presets/contour.js"
    }
  },
  "scripts": {
    "predev": "npm run registry:build",
    "dev": "next dev --webpack",
    "typecheck": "tsc --noEmit",
    "build:library": "tsc -p tsconfig.build.json",
    "registry:build": "node scripts/registry.mjs",
    "prebuild": "npm run registry:build",
    "build": "npm run build:library && next build --webpack",
    "prepack": "npm run build:library",
    "test": "npm run build:library && node --test"
  },
  "peerDependencies": {
    "@react-three/drei": "^9 || ^10",
    "@react-three/fiber": "^8 || ^9",
    "@react-three/postprocessing": "^2 || ^3",
    "postprocessing": "^6",
    "react": "^18.2 || ^19",
    "react-dom": "^18.2 || ^19",
    "three": ">=0.160 <1"
  },
  "peerDependenciesMeta": {
    "@react-three/drei": {
      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    },
    "@react-three/postprocessing": {
      "optional": true
    },
    "postprocessing": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource-variable/instrument-sans": "^5.2.8",
    "@fontsource/instrument-serif": "^5.2.7",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.6",
    "@shikijs/langs": "^4.6.0",
    "@shikijs/themes": "^4.6.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2",
    "@types/react-dom": "^19.2",
    "@types/three": "^0.183.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "geist": "^1.9.2",
    "lucide-react": "^1.76.0",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.2",
    "react-dom": "^19.2",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "three": "^0.183.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3"
  },
  "license": "MIT"
}
